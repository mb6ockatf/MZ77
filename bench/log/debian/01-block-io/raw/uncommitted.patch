+  uint8_t bytes[BITIO_BLOCK_SIZE];
+} OutputBlock;
+
+static void
+output_flush (OutputBlock *output)
+{
+  if (output->used > 0)
+    fwrite (output->bytes, 1, output->used, output->stream);
+  output->used = 0;
